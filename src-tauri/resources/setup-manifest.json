  "groups": [
    {
      "id": "core",
      "name": "运行环境",
      "components": [
        {
          "id": "uv",
          "name": "uv 工具 (0.9.10)",
          "desc": "Python 包与环境管理器，后续安装步骤依赖它（系统已装 uv 时自动识别）",
          "size_mb": 18,
          "required": true,
          "check": {
            "all": [],
            "any": [
              {
                "type": "file",
                "path": "tools/uv/uv.exe"
              },
              {
                "type": "where",
                "path": "uv"
              }
            ]
          },
          "steps": [
            {
              "type": "mkdir",
              "path": "downloads"
            },
            {
              "type": "download",
              "files": [
                {
                  "url": "gh:astral-sh/uv/releases/download/0.9.10/uv-x86_64-pc-windows-msvc.zip",
                  "to": "downloads/uv-0.9.10.zip",
                  "size": 18300000
                }
              ]
            },
            {
              "type": "unzip",
              "from": "downloads/uv-0.9.10.zip",
              "to": "tools/uv",
              "strip_first": false
            }
          ]
        },
        {
          "id": "comfyui",
          "name": "ComfyUI 引擎 (v0.38.0)",
          "desc": "生图引擎 + 独立 Python 3.11 环境 + CUDA 版 PyTorch（约 7GB 下载，最久的一步）",
          "size_mb": 8300,
          "required": true,
          "check": {
            "all": [
              {
                "type": "file",
                "path": "ComfyUI/main.py"
              },
              {
                "type": "file",
                "path": "ComfyUI/.venv/Scripts/python.exe"
              },
              {
                "type": "file",
                "path": "ComfyUI/custom_nodes/comfyui_controlnet_aux/__init__.py"
              },
              {
                "type": "file",
                "path": "ComfyUI/extra_model_paths.yaml"
              }
            ]
          },
          "steps": [
            {
              "type": "mkdir",
              "path": "downloads"
            },
            {
              "type": "download",
              "files": [
                {
                  "url": "gh:comfyanonymous/ComfyUI/archive/refs/tags/v0.38.0.zip",
                  "to": "downloads/ComfyUI-v0.38.0.zip",
                  "size": 30000000
                }
              ]
            },
            {
              "type": "unzip",
              "from": "downloads/ComfyUI-v0.38.0.zip",
              "to": "ComfyUI",
              "strip_first": true
            },
            {
              "type": "cmd",
              "name": "创建 Python 3.11 环境",
              "exe": "tools/uv/uv.exe",
              "args": [
                "venv",
                "--python",
                "3.11",
                "--python-preference",
                "only-managed",
                "ComfyUI/.venv"
              ],
              "env": {
                "UV_PYTHON_INSTALL_DIR": "{{ROOT}}/uv-python",
                "UV_PYTHON_INSTALL_MIRROR": "{{PYTHON_MIRROR}}",
                "UV_DEFAULT_INDEX": "{{PYPI_INDEX}}"
              }
            },
            {
              "type": "cmd",
              "name": "安装 PyTorch 2.13.0+cu130（约 2.6GB）",
              "exe": "tools/uv/uv.exe",
              "args": [
                "pip",
                "install",
                "--python",
                "ComfyUI/.venv/Scripts/python.exe",
                "torch==2.13.0",
                "torchvision==0.28.0",
                "torchaudio==2.11.0",
                "--index-url",
                "{{TORCH_INDEX}}"
              ]
            },
            {
              "type": "cmd",
              "name": "安装 ComfyUI 依赖",
              "exe": "tools/uv/uv.exe",
              "args": [
                "pip",
                "install",
                "--python",
                "ComfyUI/.venv/Scripts/python.exe",
                "-r",
                "ComfyUI/requirements.txt"
              ],
              "env": {
                "UV_DEFAULT_INDEX": "{{PYPI_INDEX}}"
              }
            },
            {
              "type": "download",
              "files": [
                {
                  "url": "gh:Fannovel16/comfyui_controlnet_aux/archive/refs/heads/main.zip",
                  "to": "downloads/controlnet_aux-main.zip",
                  "size": 25000000
                }
              ]
            },
            {
              "type": "unzip",
              "from": "downloads/controlnet_aux-main.zip",
              "to": "ComfyUI/custom_nodes/comfyui_controlnet_aux",
              "strip_first": true
            },
            {
              "type": "pip_requirements",
              "name": "安装姿势控制插件依赖（自动跳过需编译的包）",
              "exe": "tools/uv/uv.exe",
              "python": "ComfyUI/.venv/Scripts/python.exe",
              "requirements": "ComfyUI/custom_nodes/comfyui_controlnet_aux/requirements.txt",
              "drop": [
                "albumentationsx"
              ],
              "env": {
                "UV_DEFAULT_INDEX": "{{PYPI_INDEX}}"
              },
              "timeout_secs": 3600
            },
            {
              "type": "write_file",
              "name": "写入共享模型库配置",
              "to": "ComfyUI/extra_model_paths.yaml",
              "template": "templates/extra_model_paths.yaml"
            },
            {
              "type": "write_file",
              "name": "生成启动脚本",
              "to": "start_comfyui.bat",
              "template": "templates/start_comfyui.bat",
              "crlf": true
            }
          ]
        }
      ]
    },
