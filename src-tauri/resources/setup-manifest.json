    {
      "id": "training",
      "name": "LoRA 训练环境（可选，人物一致性用）",
      "components": [
        {
          "id": "aitk_env",
          "name": "ai-toolkit 训练环境",
          "desc": "约 6GB 下载（含 PyTorch）。含 8GB 显存必需的 3 处兼容补丁，自动应用",
          "size_mb": 6300,
          "optional": true,
          "check": {
            "all": [
              {
                "type": "file",
                "path": "ai-toolkit/run.py"
              },
              {
                "type": "file",
                "path": "ai-toolkit/.venv/Scripts/python.exe"
              },
              {
                "type": "file",
                "path": "external/diffusers/src/diffusers/__init__.py"
              }
            ]
          },
          "steps": [
            {
              "type": "download",
              "files": [
                {
                  "url": "gh:ostris/ai-toolkit/archive/refs/heads/main.zip",
                  "to": "downloads/ai-toolkit-main.zip",
                  "size": 12000000
                }
              ]
            },
            {
              "type": "unzip",
              "from": "downloads/ai-toolkit-main.zip",
              "to": "ai-toolkit",
              "strip_first": true
            },
            {
              "type": "cmd",
              "name": "创建 Python 3.12 环境",
              "exe": "tools/uv/uv.exe",
              "args": [
                "venv",
                "--python",
                "3.12",
                "--python-preference",
                "only-managed",
                "ai-toolkit/.venv"
              ],
              "env": {
                "UV_PYTHON_INSTALL_DIR": "{{ROOT}}/uv-python",
                "UV_PYTHON_INSTALL_MIRROR": "{{PYTHON_MIRROR}}",
                "UV_DEFAULT_INDEX": "{{PYPI_INDEX}}"
              },
              "timeout_secs": 900
            },
            {
              "type": "download",
              "files": [
                {
                  "url": "gh:huggingface/diffusers/archive/c943837899b16cbae2f619b8dd4f7bb6f07dd81a.zip",
                  "to": "downloads/diffusers-c9438378.zip",
                  "size": 18000000
                }
              ]
            },
            {
              "type": "unzip",
              "from": "downloads/diffusers-c9438378.zip",
              "to": "external/diffusers",
              "strip_first": true
            },
            {
              "type": "cmd",
              "name": "安装 ai-toolkit 基础依赖（含 PyTorch，较久）",
              "exe": "tools/uv/uv.exe",
              "args": [
                "pip",
                "install",
                "--python",
                "ai-toolkit/.venv/Scripts/python.exe",
                "-r",
                "ai-toolkit/requirements_base.txt"
              ],
              "env": {
                "UV_DEFAULT_INDEX": "{{PYPI_INDEX}}"
              },
              "timeout_secs": 3600
            },
            {
              "type": "cmd",
              "name": "安装 ai-toolkit 附加依赖",
              "exe": "tools/uv/uv.exe",
              "args": [
                "pip",
                "install",
                "--python",
                "ai-toolkit/.venv/Scripts/python.exe",
                "-r",
                "ai-toolkit/requirements.txt"
              ],
              "env": {
                "UV_DEFAULT_INDEX": "{{PYPI_INDEX}}"
              },
              "timeout_secs": 3600
            },
            {
              "type": "cmd",
              "name": "锁定 PyTorch 2.13.0+cu130（官方验证组合）",
              "exe": "tools/uv/uv.exe",
              "args": [
                "pip",
                "install",
                "--python",
                "ai-toolkit/.venv/Scripts/python.exe",
                "torch==2.13.0",
                "torchvision==0.28.0",
                "torchaudio==2.11.0",
                "--index-url",
                "{{TORCH_INDEX}}"
              ],
              "timeout_secs": 3600
            },
            {
              "type": "cmd",
              "name": "安装本地版 diffusers",
              "exe": "tools/uv/uv.exe",
              "args": [
                "pip",
                "install",
                "--python",
                "ai-toolkit/.venv/Scripts/python.exe",
                "--no-deps",
                "external/diffusers"
              ],
              "timeout_secs": 900
            },
            {
              "type": "apply_patch",
              "name": "应用 8GB 兼容补丁 (1/3)：逐项容错搬运",
              "resource": "aitk/patched/BaseSDTrainProcess.py",
              "to": "ai-toolkit/jobs/process/BaseSDTrainProcess.py",
              "marker": "cannot kill the run"
            },
            {
              "type": "apply_patch",
              "name": "应用 8GB 兼容补丁 (2/3)：dtype 对齐",
              "resource": "aitk/patched/manager_modules.py",
              "to": "ai-toolkit/toolkit/memory_management/manager_modules.py",
              "marker": "align staged weight dtype with the incoming activations"
            },
            {
              "type": "apply_patch",
              "name": "应用 8GB 兼容补丁 (3/3)：禁用假 OOM 开关",
              "resource": "aitk/patched/z_image.py",
              "to": "ai-toolkit/toolkit/models/v2/diffusion_models/z_image.py",
              "marker": "keep disabled"
            },
            {
              "type": "mkdir",
              "path": "ai-toolkit/datasets/character"
            },
            {
              "type": "mkdir",
              "path": "outputs/training"
            },
            {
              "type": "write_file",
              "name": "写入训练配置",
              "to": "ai-toolkit/config/zimage_character_8gb.yml",
              "template": "aitk/zimage_character_8gb.yml"
            },
            {
              "type": "write_file",
              "name": "生成训练脚本",
              "to": "train_zimage.bat",
              "template": "templates/train_zimage.bat",
              "crlf": true
            }
          ]
        },
